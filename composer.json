{
    "name": "hawkiq/hwkui",
    "description": "Widgets library for Laravel Livewire 3",
    "license": "MIT",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Hawkiq\\Hwkui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hawkiq\\Hwkui\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hawkiq\\Hwkui\\HwkuiServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "hawkiq",
            "email": "info@osama.app"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "pestphp/pest": "*",
        "pestphp/pest-plugin-laravel": "*",
        "orchestra/testbench": "*",
        "laravel/pint": "*",
        "phpstan/phpstan": "*"
    },
    "require": {
        "livewire/livewire": "^3.0|^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "php -d zend.assertions=1 -r \"if (!extension_loaded('xdebug') && !extension_loaded('pcov')) { fwrite(STDERR, 'No code coverage driver is available.\\n'); exit(1); }\" && pest --coverage",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
